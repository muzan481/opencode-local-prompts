#!/usr/bin/env bash
# opencode-local — prepara Ollama + modelos locales y (opcionalmente) abre OpenCode.
set -euo pipefail

DEFAULT_MODELS=("qwen2.5-coder:3b")
MODEL="${MODEL:-${DEFAULT_MODELS[0]}}"
OLLAMA_HOST="${OLLAMA_HOST:-127.0.0.1:11434}"
export OLLAMA_HOST

# Límites conservadores para RAM ajustada.
export OLLAMA_MAX_LOADED_MODELS="${OLLAMA_MAX_LOADED_MODELS:-1}"
export OLLAMA_NUM_PARALLEL="${OLLAMA_NUM_PARALLEL:-1}"

# Host usable para conectarse (0.0.0.0 no siempre sirve como URL).
CONNECT_HOST="$OLLAMA_HOST"
case "$CONNECT_HOST" in
  0.0.0.0:*) CONNECT_HOST="127.0.0.1:${CONNECT_HOST#0.0.0.0:}" ;;
  *:*) ;;
  *) CONNECT_HOST="127.0.0.1:${CONNECT_HOST}" ;;
esac
OLLAMA_BASE="http://${CONNECT_HOST}"
KEEP_ALIVE="${OPENCODE_LOCAL_KEEP_ALIVE:-10m}"
CONTEXT="${OPENCODE_LOCAL_CONTEXT:-16384}"
LAUNCH=1
PULL=1

usage() {
  cat <<EOF
Uso: opencode-local [opciones] [directorio]

Prepara Ollama y los modelos locales necesarios; luego abre OpenCode.

Modelos predeterminados que prepara este script:
  - qwen2.5-coder:3b     (agentes qwen-lisp, qwen-lua y qwen-python)

Opciones:
  --no-launch   Solo prepara el entorno, no abre OpenCode.
  --no-pull     No descarga modelos si faltan. Muestra qué falta y los comandos para instalarlos.
  -h, --help    Muestra esta ayuda.

Variables:
  MODEL                     Modelo activo para configurar/abrir OpenCode (por defecto: ${DEFAULT_MODELS[0]})
  OLLAMA_HOST               Host de Ollama (por defecto: $OLLAMA_HOST)
  OPENCODE_LOCAL_KEEP_ALIVE Tiempo que el modelo queda cargado (por defecto: $KEEP_ALIVE)
  OPENCODE_LOCAL_CONTEXT    Contexto a forzar; 0 usa el modelo tal cual (por defecto: $CONTEXT)

Ejemplos:
  opencode-local
  opencode-local --no-launch
  MODEL=deepseek-r1:1.5b opencode-local --no-launch
EOF
}

args=()
for arg in "$@"; do
  case "$arg" in
    --no-launch) LAUNCH=0 ;;
    --no-pull) PULL=0 ;;
    -h|--help) usage; exit 0 ;;
    *) args+=("$arg") ;;
  esac
done

say()  { printf '%s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
ok()   { printf '✓ %s\n' "$*"; }
warn() { printf '⚠ %s\n' "$*" >&2; }
die()  { printf '✗ %s\n' "$*" >&2; exit 1; }

model_installed() {
  ollama list 2>/dev/null | awk 'NR > 1 { print $1 }' | grep -Fxq "$1"
}

variant_name() {
  local base="$1" ctx="$2"
  printf '%s-ctx%s' "$base" "$ctx"
}

variant_ready() {
  local base="$1" ctx="$2" var
  var="$(variant_name "$base" "$ctx")"
  ollama show "$var" 2>/dev/null | grep -Eq "num_ctx[[:space:]]+${ctx}([[:space:]]|$)"
}

ensure_variant() {
  local base="$1" ctx="$2" var modefile create_log max_ctx
  [ -n "$ctx" ] && [ "$ctx" != "0" ] || return 0

  max_ctx="$(ollama show "$base" 2>/dev/null | awk '/context length/ { print $3; exit }')"
  if [ -n "$max_ctx" ] && [ "$ctx" -gt "$max_ctx" ]; then
    warn "El modelo $base soporta $max_ctx de contexto; usando $max_ctx."
    ctx="$max_ctx"
  fi
  [ "$ctx" -gt 0 ] || return 0

  var="$(variant_name "$base" "$ctx")"
  if variant_ready "$base" "$ctx"; then
    ok "Variante con contexto: $var (${ctx} tokens)"
    return 0
  fi

  info "Creando variante $var con contexto ${ctx}..."
  modefile="$(mktemp "${TMPDIR:-/tmp}/opencode-local-modelfile.XXXXXX")"
  printf 'FROM %s\nPARAMETER num_ctx %s\n' "$base" "$ctx" >"$modefile"
  create_log="$(mktemp "${TMPDIR:-/tmp}/opencode-local-create.XXXXXX")"
  if ! ollama create "$var" -f "$modefile" >"$create_log" 2>&1; then
    cat "$create_log" >&2
    rm -f "$modefile" "$create_log"
    die "No se pudo crear la variante $var."
  fi
  rm -f "$modefile" "$create_log"
  ok "Variante creada: $var (${ctx} tokens)"
}

say "==> Preparando OpenCode con modelos locales"
say ""

# 1) Ollama ---------------------------------------------------------------
command -v ollama >/dev/null 2>&1 || die "No encontré 'ollama' en PATH. Instálalo con: curl -fsSL https://ollama.com/install.sh | sh"

if curl -fsS -m 2 "$OLLAMA_BASE/api/version" >/dev/null 2>&1; then
  ok "Ollama ya está corriendo en $CONNECT_HOST"
else
  info "Iniciando Ollama..."
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/opencode-local"
  mkdir -p "$STATE_DIR"
  LOG="$STATE_DIR/ollama.log"

  if command -v setsid >/dev/null 2>&1; then
    setsid env OLLAMA_KEEP_ALIVE="$KEEP_ALIVE" ollama serve >"$LOG" 2>&1 </dev/null &
  else
    nohup env OLLAMA_KEEP_ALIVE="$KEEP_ALIVE" ollama serve >"$LOG" 2>&1 </dev/null &
    disown 2>/dev/null || true
  fi

  for _ in $(seq 1 60); do
    if curl -fsS -m 2 "$OLLAMA_BASE/api/version" >/dev/null 2>&1; then
      break
    fi
    sleep 0.5
  done

  if ! curl -fsS -m 2 "$OLLAMA_BASE/api/version" >/dev/null 2>&1; then
    warn "Ollama no respondió en $OLLAMA_BASE."
    if [ -f "$LOG" ]; then
      warn "Últimas líneas de $LOG:"
      tail -n 20 "$LOG" >&2 || true
    fi
    die "No se pudo iniciar Ollama."
  fi
  ok "Ollama iniciado en $CONNECT_HOST"
fi

# 2) Modelos predeterminados ----------------------------------------------
say ""
say "Modelos predeterminados que usa este script:"
for m in "${DEFAULT_MODELS[@]}"; do
  say "  - $m"
done
say ""

MISSING=()
for m in "${DEFAULT_MODELS[@]}"; do
  if model_installed "$m"; then
    ok "Modelo disponible: $m"
  else
    MISSING+=("$m")
  fi
done

if [ "${#MISSING[@]}" -gt 0 ]; then
  warn "Faltan estos modelos: ${MISSING[*]}"
  if [ "$PULL" -eq 1 ]; then
    for m in "${MISSING[@]}"; do
      info "Descargando $m (puede tardar)..."
      ollama pull "$m"
      ok "Modelo descargado: $m"
    done
  else
    say ""
    say "Para instalar los modelos predeterminados que usa este script, ejecuta:"
    for m in "${MISSING[@]}"; do
      say "  ollama pull $m"
    done
    if [ -n "$CONTEXT" ] && [ "$CONTEXT" != "0" ]; then
      say ""
      say "Después crea sus variantes de contexto:"
      for m in "${MISSING[@]}"; do
        say "  printf 'FROM %s\\nPARAMETER num_ctx %s\\n' '$m' '$CONTEXT' | ollama create $(variant_name "$m" "$CONTEXT") -f -"
      done
    fi
    say ""
    die "Faltan modelos (se usó --no-pull). Ejecuta los comandos de arriba y vuelve a intentarlo."
  fi
fi

# Asegurar también el modelo activo si el usuario lo cambió y no es uno de los predeterminados.
if ! model_installed "$MODEL"; then
  warn "El modelo activo solicitado no está instalado: $MODEL"
  if [ "$PULL" -eq 1 ]; then
    info "Descargando $MODEL (puede tardar)..."
    ollama pull "$MODEL"
    ok "Modelo descargado: $MODEL"
  else
    say ""
    say "Para instalar el modelo activo solicitado, ejecuta:"
    say "  ollama pull $MODEL"
    if [ -n "$CONTEXT" ] && [ "$CONTEXT" != "0" ]; then
      say "  printf 'FROM %s\\nPARAMETER num_ctx %s\\n' '$MODEL' '$CONTEXT' | ollama create $(variant_name "$MODEL" "$CONTEXT") -f -"
    fi
    die "Falta el modelo activo (se usó --no-pull)."
  fi
fi

# 2b) Variantes de contexto -----------------------------------------------
for m in "${DEFAULT_MODELS[@]}"; do
  ensure_variant "$m" "$CONTEXT"
done
# Variante del activo si es distinto
active_is_default=0
for m in "${DEFAULT_MODELS[@]}"; do [ "$m" = "$MODEL" ] && active_is_default=1; done
if [ "$active_is_default" -eq 0 ]; then
  ensure_variant "$MODEL" "$CONTEXT"
fi

EFFECTIVE_MODEL="$MODEL"
if [ -n "$CONTEXT" ] && [ "$CONTEXT" != "0" ]; then
  EFFECTIVE_MODEL="$(variant_name "$MODEL" "$CONTEXT")"
fi

# 3) Precarga -------------------------------------------------------------
info "Cargando $EFFECTIVE_MODEL en memoria..."
if curl -fsS -m 180 "$OLLAMA_BASE/api/generate" \
  -H 'Content-Type: application/json' \
  -d "{\"model\":\"$EFFECTIVE_MODEL\",\"prompt\":\"ok\",\"stream\":false,\"options\":{\"num_predict\":1},\"keep_alive\":\"$KEEP_ALIVE\"}" \
  >/dev/null 2>&1; then
  ok "Modelo cargado (keep_alive=$KEEP_ALIVE)"
else
  warn "No pude precargar el modelo; OpenCode lo cargará en el primer mensaje."
fi

# 4) Configuración --------------------------------------------------------
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
mkdir -p "$CONFIG_DIR"
if [ -f "$CONFIG_DIR/opencode.jsonc" ]; then
  CONFIG="$CONFIG_DIR/opencode.jsonc"
elif [ -f "$CONFIG_DIR/opencode.json" ]; then
  CONFIG="$CONFIG_DIR/opencode.json"
else
  CONFIG="$CONFIG_DIR/opencode.jsonc"
fi

if command -v python3 >/dev/null 2>&1; then
  python3 - "$CONFIG" "ollama/$EFFECTIVE_MODEL" <<'PY'
import sys

path, value = sys.argv[1], sys.argv[2]
try:
    with open(path, encoding="utf-8") as f:
        src = f.read()
except FileNotFoundError:
    src = ""

def find_top_level_model(s):
    i = 0
    n = len(s)
    depth = 0
    in_str = False
    esc = False
    line_comment = False
    block_comment = False
    str_start = 0
    str_depth = 0

    while i < n:
        c = s[i]
        nxt = s[i + 1] if i + 1 < n else ""

        if line_comment:
            if c == "\n":
                line_comment = False
            i += 1
            continue

        if block_comment:
            if c == "*" and nxt == "/":
                block_comment = False
                i += 2
                continue
            i += 1
            continue

        if in_str:
            if esc:
                esc = False
            elif c == "\\":
                esc = True
            elif c == '"':
                in_str = False
                if s[str_start:i] == "model" and str_depth == 1:
                    k = i + 1
                    while k < n and s[k] in " \t\r\n":
                        k += 1
                    if k < n and s[k] == ":":
                        v = k + 1
                        while v < n and s[v] in " \t\r\n":
                            v += 1
                        if v < n and s[v] == '"':
                            e = v + 1
                            vesc = False
                            while e < n:
                                ch = s[e]
                                if vesc:
                                    vesc = False
                                elif ch == "\\":
                                    vesc = True
                                elif ch == '"':
                                    return (v, e + 1)
                                e += 1
                            return (v, n)
                        e = v
                        d = 0
                        while e < n:
                            ch = s[e]
                            if ch in "{[":
                                d += 1
                            elif ch in "}]":
                                if d == 0:
                                    break
                                d -= 1
                            elif ch == "," and d == 0:
                                break
                            e += 1
                        while e > v and s[e - 1] in " \t\r\n":
                            e -= 1
                        return (v, e)
            i += 1
            continue

        if c == "/" and nxt == "/":
            line_comment = True
            i += 2
            continue
        if c == "/" and nxt == "*":
            block_comment = True
            i += 2
            continue
        if c == '"':
            in_str = True
            esc = False
            str_start = i + 1
            str_depth = depth
            i += 1
            continue
        if c in "{[":
            depth += 1
        elif c in "}]":
            depth -= 1
        i += 1

    return None

escaped = value.replace("\\", "\\\\").replace('"', '\\"')
span = find_top_level_model(src)

if span is not None:
    a, b = span
    src = src[:a] + '"' + escaped + '"' + src[b:]
elif "{" in src:
    idx = src.index("{")
    rest = src[idx + 1:]
    if rest.lstrip().startswith("}"):
        src = src[:idx + 1] + '\n  "model": "' + escaped + '"\n' + rest
    else:
        src = src[:idx + 1] + '\n  "model": "' + escaped + '",' + rest
else:
    src = '{ "model": "' + escaped + '" }\n'

with open(path, "w", encoding="utf-8") as f:
    f.write(src)
PY
  ok "Configuración: $CONFIG → ollama/$EFFECTIVE_MODEL"
else
  warn "No encontré python3; no pude actualizar $CONFIG automáticamente."
  warn "Asegúrate de que contenga: \"model\": \"ollama/$EFFECTIVE_MODEL\""
fi

# 5) Verificación en OpenCode --------------------------------------------
command -v opencode >/dev/null 2>&1 || die "No encontré 'opencode' en PATH."

opencode reload >/dev/null 2>&1 || true

found=0
for _ in $(seq 1 20); do
  if opencode models 2>/dev/null | grep -Fxq "ollama/$EFFECTIVE_MODEL"; then
    found=1
    break
  fi
  sleep 0.5
done

if [ "$found" -ne 1 ]; then
  warn "OpenCode aún no lista el modelo; reiniciando el servicio en segundo plano..."
  opencode service restart >/dev/null 2>&1 || true
  for _ in $(seq 1 20); do
    if opencode models 2>/dev/null | grep -Fxq "ollama/$EFFECTIVE_MODEL"; then
      found=1
      break
    fi
    sleep 0.5
  done
fi

if [ "$found" -eq 1 ]; then
  ok "OpenCode detecta ollama/$EFFECTIVE_MODEL"
else
  warn "OpenCode todavía no lista ollama/$EFFECTIVE_MODEL. Prueba: opencode reload"
fi

case "$MODEL" in
  *1.5b*|*1.5B*)
    info "Nota: un modelo de 1.5B puede fallar al usar herramientas (editar archivos, ejecutar comandos)."
    ;;
esac

# 6) Abrir OpenCode -------------------------------------------------------
say ""
if [ "$LAUNCH" -eq 1 ]; then
  say "==> Abriendo OpenCode con $EFFECTIVE_MODEL"
  if [ "${#args[@]}" -gt 0 ]; then
    exec opencode "${args[@]}"
  else
    exec opencode
  fi
else
  ok "Todo listo. Abre OpenCode con: opencode"
fi
